<?xml version="1.0" encoding="utf-8"?>
<!-- Network Security Config - cho phep HTTP traffic cho moi domain. -->
<!-- Can thiet cho Android 9+ (API 28+) vi mac dinh chan HTTP cleartext. -->
<network-security-config>
  <base-config cleartextTrafficPermitted="true">
    <trust-anchors>
      <certificates src="system" />
    </trust-anchors>
  </base-config>
</network-security-config>
